{
  "name": "wazeko-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Wazeko — A TypeScript-native asynchronous WhatsApp Web client library",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/examples/enterprise-bot.js",
    "start:prod": "NODE_ENV=production node dist/examples/enterprise-bot.js",
    "test": "node --test dist/tests/*.test.js",
    "bench": "node dist/benchmarks/protocol-bench.js"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "websocket",
    "client",
    "typescript",
    "multi-device",
    "signal-protocol",
    "noise-protocol",
    "e2ee"
  ],
  "author": "Wazeko Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/ws": "^8.5.10",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.4.5"
  }
}
